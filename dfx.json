{
  "canisters": {
    "twinvest_backend": {
      "main": "src/twinvest_backend/main.mo",
      "type": "motoko",
      "dependencies": ["role_registry"]
    },
    "test_caller": {
      "main": "src/twinvest_backend/test_caller.mo",
      "type": "motoko"
    },
    "role_registry": {
      "type": "motoko",
      "main": "src/role_registry/main.mo"
    },
    "twinvest_frontend": {
      "dependencies": [
        "twinvest_backend"
      ],
      "source": [
        "src/twinvest_frontend/dist"
      ],
      "type": "assets",
      "workspace": "twinvest_frontend",
      "content_security_policy": "default-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* https://icp0.io https://*.icp0.io https://icp-api.io; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval';"
    }
  },
  "defaults": {
    "build": {
      "args": "",
      "packtool": ""
    }
  },
  "output_env_file": ".env",
  "version": 1
}